## Puerto público para acceso HTTPS (nginx)
DRAWIO_PUBLIC_PORT=443
## Puerto HTTP (solo para redirección a HTTPS)
DRAWIO_HTTP_PORT=80

## Configuración de la aplicación
DRAWIO_DOWNLOAD_TTL=86400
DRAWIO_CATALOG_TTL=300
DRAWIO_MAX_UPLOAD_BYTES=15728640

## SEGURIDAD - IMPORTANTE: Cambia estos valores en producción
## Genera una clave secreta fuerte con: python -c "import secrets; print(secrets.token_hex(32))"
DRAWIO_SECRET_KEY=CAMBIAR_POR_UNA_CADENA_ALEATORIA_LARGA_GENERADA_CON_EL_COMANDO_ANTERIOR

## Seguridad de cookies (siempre 1 cuando se usa HTTPS)
DRAWIO_COOKIE_SECURE=1

## Forzar HTTPS en la aplicación Flask (0 cuando nginx maneja HTTPS)
DRAWIO_FORCE_HTTPS=0

## Duración de la sesión en horas
DRAWIO_SESSION_HOURS=8

## Rate limiting storage (redis:// o memory://)
DRAWIO_RATELIMIT_STORAGE=redis://redis:6379

## Configuración de Draw.io
DRAWIO_PREVIEW_URL=https://embed.diagrams.net/

## Configuración de GLPI
GLPI_URL=https://tickets.example.net/apirest.php
GLPI_WEB_URL=https://tickets.example.net
GLPI_APP_TOKEN=CAMBIAR
GLPI_USER_TOKEN=CAMBIAR

## AusartaConecta / comms (importar ofertas work-order)
COMMS_URL=https://comms.aureamotriz.com
## Opción A: usuario y contraseña del portal (mismo login web)
COMMS_USERNAME=
COMMS_PASSWORD=
## Opción B: token API si el equipo de comms lo proporciona
COMMS_API_TOKEN=
