## Puerto público para acceso HTTPS (nginx)
DRAWIO_PUBLIC_PORT=443
## Puerto HTTP (solo para redirección a HTTPS)
DRAWIO_HTTP_PORT=80

## Configuración de la aplicación
DRAWIO_DOWNLOAD_TTL=86400
DRAWIO_CATALOG_TTL=300
DRAWIO_MAX_UPLOAD_BYTES=15728640

## SEGURIDAD - IMPORTANTE: Cambia estos valores en producción
## Genera una clave secreta fuerte con: python -c "import secrets; print(secrets.token_hex(32))"
DRAWIO_SECRET_KEY=CAMBIAR_POR_UNA_CADENA_ALEATORIA_LARGA_GENERADA_CON_EL_COMANDO_ANTERIOR

## Seguridad de cookies (siempre 1 cuando se usa HTTPS)
DRAWIO_COOKIE_SECURE=1

## Forzar HTTPS en la aplicación Flask (0 cuando nginx maneja HTTPS)
DRAWIO_FORCE_HTTPS=0

## Duración de la sesión en horas
DRAWIO_SESSION_HOURS=8

## Rate limiting storage (redis:// o memory://)
DRAWIO_RATELIMIT_STORAGE=redis://redis:6379

## Configuración de Draw.io
DRAWIO_PREVIEW_URL=https://embed.diagrams.net/

## Backup SQLite (servicio backup en docker-compose.yml)
## Retencion de copias en dias; horario diario 03:00 (TZ del contenedor)
DRAWIO_BACKUP_RETENTION_DAYS=7
TZ=Europe/Madrid

## Configuración de GLPI
GLPI_URL=https://tickets.example.net/apirest.php
## URL web de GLPI (sin /apirest.php). Los enlaces a diagramas usan:
## {GLPI_WEB_URL}/marketplace/archimap/front/graph.form.php?id={id}
GLPI_WEB_URL=https://tickets.example.net
GLPI_APP_TOKEN=CAMBIAR
GLPI_USER_TOKEN=CAMBIAR
## Verificar certificado SSL del API GLPI (0/false para instalaciones on-premise con cert autofirmado)
GLPI_VERIFY_SSL=1

## CRM (importar OT por work order ID via API Aureamotriz)
## GET {CRM_API_URL}{CRM_WORK_ORDER_PATH}  -> JSON {status, result}
CRM_API_URL=https://comms-back.aureamotriz.com
CRM_API_TOKEN=
CRM_WORK_ORDER_PATH=/WorkOrders/getWorkOrderForDraw/{work_order_id}
CRM_API_TIMEOUT=20

## AusartaConecta / comms (fallback si CRM no esta configurado)
COMMS_URL=https://comms.aureamotriz.com
## Opción A: usuario y contraseña del portal (mismo login web)
COMMS_USERNAME=
COMMS_PASSWORD=
## Opción B: token API si el equipo de comms lo proporciona
COMMS_API_TOKEN=

## Versión de la librería de dispositivos (sin extensión .xml)
DRAWIO_LIBRARY_VERSION=libreria_Ausarta_JUN_2026

## Ruta del log de seguridad persistente (SQLite)
DRAWIO_SECLOG_DB=/app/data/security.sqlite3

# Usuarios con acceso al panel /admin (nombre completo, separados por comas).
DRAWIO_ADMIN_USERS=nombre apellido,otro nombre

## Zabbix (alta automatica de hosts)
ZABBIX_BASE_URL=http://zabbix.example.net:181
## Opcional: URL completa del API JSON-RPC (si no se define, se usa ZABBIX_BASE_URL + ZABBIX_API_PATH)
# ZABBIX_API_URL=http://zabbix.example.net:181/zabbix/api_jsonrpc.php
ZABBIX_API_PATH=/zabbix/api_jsonrpc.php
ZABBIX_API_TOKEN=CAMBIAR
ZABBIX_HTTP_TIMEOUT_MS=7000
## Valores por defecto (opcional)
# Comunidad SNMP por defecto (si se omite: ausarta@conecta)
# ZABBIX_DEFAULT_SNMP_COMMUNITY=
# Usuario RouterOS por defecto (si se omite: Ausarta)
# ZABBIX_ROUTEROS_USERNAME=

## Plantillas Zabbix (IDs reales; ya vienen por defecto en el codigo, solo
## defínelas si cambian en tu servidor)
# ZABBIX_TEMPLATE_SNMP_FIBRA=10747        # siempre en el router de fibra
# ZABBIX_TEMPLATE_ROUTEROS_BGP=11208      # RouterOS < v7
# ZABBIX_TEMPLATE_ROUTEROS_BGP_V7=13463   # RouterOS >= v7
# ZABBIX_TEMPLATE_SNMP_BACKUP=10758       # backup (WAP/Teltonika/Kite)

## Helper de version RouterOS (opcion A): corre en el HOST y alcanza los routers
## por el tunel wg. Instalar con: sudo bash scripts/install_routeros_helper.sh
## (ese script imprime estas dos lineas ya con el token generado).
# ROUTEROS_HELPER_URL=http://172.28.0.1:49500
# ROUTEROS_HELPER_TOKEN=

## Helper de credenciales Passbolt (opcion B): sidecar en el HOST que reutiliza el
## passbolt-provider.js de NOP para rellenar {$ROUTEROS_PASSWORD} automaticamente.
## Instalar con: sudo bash scripts/install_credential_helper.sh (imprime estas lineas).
## Requiere que un dev complete el bloque "DEV: COMPLETAR" en scripts/credential_helper.js.
# PASSBOLT_HELPER_URL=http://172.28.0.1:49600
# PASSBOLT_HELPER_TOKEN=

# --- Sidecars del host (credential-helper 49600 / routeros-helper 49500) ---
# Topología interna (mover a entorno; no dejar hardcodeado en el código):
#TUNNELS_ROUTER_IP=45.13.211.10
#TUNNELS_ROUTER_USER=api
#TUNNELS_ROUTER_PASS=                # OBLIGATORIO para consultar IPs de túnel del backup
#ROUTEROS_WG_SOURCE_ADDR=10.10.10.3  # IP de origen (WireGuard) para la API RouterOS
# Bind de los sidecars: por seguridad, solo el bridge Docker (no 0.0.0.0):
#CRED_HELPER_BIND=172.28.0.1
#ROUTEROS_HELPER_BIND=172.28.0.1
# Tokens de los sidecars: PONERLOS (mismo valor en la app y en el sidecar):
#CRED_HELPER_TOKEN=            # == PASSBOLT_HELPER_TOKEN de la app
#ROUTEROS_HELPER_TOKEN=        # == ROUTEROS_HELPER_TOKEN de la app
# Zabbix por HTTP (token de API viaja en claro): solo LAN; mejor HTTPS.
#ZABBIX_ALLOW_INSECURE=1
